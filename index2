<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>طلبات البيت | Home Pantry</title>
    <!-- خط Tajawal من Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.08);
            --primary: #10b981;
            --primary-hover: #059669;
            --accent: #6366f1;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --danger: #ef4444;
            --radius: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            padding-bottom: 90px;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(99, 102, 241, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.15) 0%, transparent 40%);
            background-attachment: fixed;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px 16px;
        }

        header {
            text-align: center;
            margin-bottom: 24px;
        }

        header h1 {
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #10b981, #6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        header p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 4px;
        }

        /* Glassmorphism Card System */
        .card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--card-border);
            border-radius: var(--radius);
            padding: 18px;
            margin-bottom: 16px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Forms & Inputs */
        .form-group {
            margin-bottom: 14px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        input[type="text"] {
            width: 100%;
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid var(--card-border);
            background: rgba(15, 23, 42, 0.6);
            color: var(--text-main);
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus {
            border-color: var(--primary);
        }

        .btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn-primary {
            background: var(--primary);
            color: #000;
        }

        .btn-primary:hover {
            background: var(--primary-hover);
        }

        .btn-accent {
            background: var(--accent);
            color: #fff;
        }

        .btn-danger-outline {
            background: transparent;
            border: 1px solid var(--danger);
            color: var(--danger);
            padding: 6px 12px;
            font-size: 0.8rem;
            width: auto;
        }

        /* Category Chips Selection */
        .chips-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
            max-height: 180px;
            overflow-y: auto;
            padding: 4px;
        }

        .chip {
            padding: 8px 14px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--card-border);
            color: var(--text-main);
            font-size: 0.85rem;
            cursor: pointer;
            user-select: none;
            transition: all 0.2s;
        }

        .chip.selected {
            background: var(--primary);
            color: #000;
            font-weight: 700;
            border-color: var(--primary);
        }

        /* Order Items & Checklist */
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .order-title {
            font-size: 1.2rem;
            font-weight: 700;
        }

        .order-date {
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .progress-bar {
            height: 6px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 14px;
        }

        .progress-fill {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.3s ease;
        }

        .item-list {
            list-style: none;
        }

        .item-row {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            border-radius: 10px;
            background: rgba(15, 23, 42, 0.4);
            margin-bottom: 8px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .item-row:hover {
            background: rgba(15, 23, 42, 0.8);
        }

        .checkbox {
            width: 20px;
            height: 20px;
            border-radius: 6px;
            border: 2px solid var(--text-muted);
            margin-left: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .item-row.bought .checkbox {
            background: var(--primary);
            border-color: var(--primary);
        }

        .item-row.bought .checkbox::after {
            content: '✓';
            color: #000;
            font-size: 12px;
            font-weight: bold;
        }

        .item-row.bought .item-name {
            text-decoration: line-through;
            color: var(--text-muted);
        }

        /* Catalog Management */
        .catalog-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .catalog-item {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.05);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
        }

        .catalog-item span.remove {
            color: var(--danger);
            cursor: pointer;
            font-weight: bold;
        }

        /* Bottom Navigation */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 70px;
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(16px);
            border-top: 1px solid var(--card-border);
            display: flex;
            justify-content: space-around;
            align-items: center;
            max-width: 600px;
            margin: 0 auto;
            z-index: 100;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 0.75rem;
            gap: 4px;
            transition: color 0.2s;
        }

        .nav-item.active {
            color: var(--primary);
            font-weight: 700;
        }

        .nav-item svg {
            width: 22px;
            height: 22px;
            fill: currentColor;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>طلبات البيت 🛒</h1>
            <p>إدارة الطلبيات والمكونات بكل سهولة</p>
        </header>

        <!-- Tab 1: Current Orders -->
        <div id="orders-tab" class="tab-content active">
            <div id="orders-container"></div>
        </div>

        <!-- Tab 2: Create New Order -->
        <div id="new-order-tab" class="tab-content">
            <div class="card">
                <h3 style="margin-bottom: 14px;">إنشاء طلبية جديدة</h3>
                <div class="form-group">
                    <label>عنوان الطلبية</label>
                    <input type="text" id="order-title-input" placeholder="مثال: طلبات السوبرماركت، العثيم...">
                </div>
                <div class="form-group">
                    <label>اختر المكونات من القائمة</label>
                    <div id="chips-container" class="chips-grid"></div>
                </div>
                <div class="form-group">
                    <label>أو أضف مكون جديد سريع</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" id="custom-item-input" placeholder="صنف جديد...">
                        <button type="button" class="btn btn-accent" style="width: auto; padding: 0 16px;" onclick="addQuickItem()">إضافة</button>
                    </div>
                </div>
                <button class="btn btn-primary" onclick="createNewOrder()" style="margin-top: 20px;">حفظ وإنشاء الطلبية</button>
            </div>
        </div>

        <!-- Tab 3: Catalog Management -->
        <div id="catalog-tab" class="tab-content">
            <div class="card">
                <h3 style="margin-bottom: 14px;">دليل المكونات والأصناف</h3>
                <div class="form-group" style="display: flex; gap: 8px;">
                    <input type="text" id="new-catalog-input" placeholder="إضافة صنف دائم (مثال: لبن، رز...)">
                    <button class="btn btn-primary" style="width: auto; padding: 0 16px;" onclick="addCatalogItem()">إضافة</button>
                </div>
                <div id="catalog-list-container" class="catalog-list"></div>
            </div>

            <div class="card">
                <h3 style="margin-bottom: 10px; font-size: 1rem;">النسخ الاحتياطي للبيانات</h3>
                <div style="display: flex; gap: 10px;">
                    <button class="btn btn-accent" style="font-size: 0.85rem;" onclick="exportData()">تحميل النسخة (JSON)</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="bottom-nav">
        <div class="nav-item active" onclick="switchTab('orders-tab', this)">
            <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
            <span>الطلبيات</span>
        </div>
        <div class="nav-item" onclick="switchTab('new-order-tab', this)">
            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
            <span>طلبية جديدة</span>
        </div>
        <div class="nav-item" onclick="switchTab('catalog-tab', this)">
            <svg viewBox="0 0 24 24"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
            <span>المكونات</span>
        </div>
    </nav>

    <script>
        // Data Store Template
        const defaultCatalog = [
            "رز 5 كيلو", "شعرية 2 كيلو", "مكرونة 4 أكياس", 
            "زجاجة زيت كبيرة", "زجاجة خل", "علبة مرقة ماجي", 
            "سكر 5 كيلو", "علبة جبنة صغيرة", "حلاوة طحينية", 
            "مربى", "لانشون", "لحمة مفرومة 2 كيلو", "دقيق"
        ];

        let state = {
            catalog: JSON.parse(localStorage.getItem('pantry_catalog')) || defaultCatalog,
            orders: JSON.parse(localStorage.getItem('pantry_orders')) || [],
            selectedTempItems: new Set()
        };

        function saveData() {
            localStorage.setItem('pantry_catalog', JSON.stringify(state.catalog));
            localStorage.setItem('pantry_orders', JSON.stringify(state.orders));
        }

        // Navigation
        function switchTab(tabId, el) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            el.classList.add('active');

            if(tabId === 'new-order-tab') renderChips();
            if(tabId === 'catalog-tab') renderCatalog();
            if(tabId === 'orders-tab') renderOrders();
        }

        // Render Catalog Chips for New Order
        function renderChips() {
            const container = document.getElementById('chips-container');
            container.innerHTML = '';
            state.catalog.forEach(item => {
                const chip = document.createElement('div');
                chip.className = `chip ${state.selectedTempItems.has(item) ? 'selected' : ''}`;
                chip.innerText = item;
                chip.onclick = () => {
                    if (state.selectedTempItems.has(item)) {
                        state.selectedTempItems.delete(item);
                    } else {
                        state.selectedTempItems.add(item);
                    }
                    renderChips();
                };
                container.appendChild(chip);
            });
        }

        function addQuickItem() {
            const input = document.getElementById('custom-item-input');
            const val = input.value.trim();
            if(val) {
                state.selectedTempItems.add(val);
                if(!state.catalog.includes(val)) {
                    state.catalog.push(val);
                    saveData();
                }
                input.value = '';
                renderChips();
            }
        }

        // Create Order
        function createNewOrder() {
            const titleInput = document.getElementById('order-title-input');
            const title = titleInput.value.trim() || 'طلبية منزلية';
            
            if (state.selectedTempItems.size === 0) {
                alert('رجاء اختيار مكون أو صنف واحد على الأقل للطلبية');
                return;
            }

            const newOrder = {
                id: 'order_' + Date.now(),
                title: title,
                date: new Date().toLocaleDateString('ar-EG', { day: 'numeric', month: 'short', year: 'numeric' }),
                items: Array.from(state.selectedTempItems).map(name => ({ name, bought: false }))
            };

            state.orders.unshift(newOrder);
            saveData();

            // Reset Form
            titleInput.value = '';
            state.selectedTempItems.clear();

            // Navigate to orders
            switchTab('orders-tab', document.querySelectorAll('.nav-item')[0]);
        }

        // Render Orders List
        function renderOrders() {
            const container = document.getElementById('orders-container');
            container.innerHTML = '';

            if (state.orders.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <p style="font-size: 3rem;">📝</p>
                        <p>لا توجد طلبيات حالية.</p>
                        <p style="font-size:0.8rem; margin-top:6px;">اضغط على "طلبية جديدة" للبدء.</p>
                    </div>
                `;
                return;
            }

            state.orders.forEach(order => {
                const total = order.items.length;
                const boughtCount = order.items.filter(i => i.bought).length;
                const percent = total > 0 ? Math.round((boughtCount / total) * 100) : 0;

                const card = document.createElement('div');
                card.className = 'card';
                card.innerHTML = `
                    <div class="order-header">
                        <div>
                            <div class="order-title">${order.title}</div>
                            <div class="order-date">${order.date} •تم شراء ${boughtCount} من ${total}</div>
                        </div>
                        <button class="btn btn-danger-outline" onclick="deleteOrder('${order.id}')">حذف</button>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: ${percent}%"></div>
                    </div>
                    <ul class="item-list">
                        ${order.items.map((item, idx) => `
                            <li class="item-row ${item.bought ? 'bought' : ''}" onclick="toggleItem('${order.id}', ${idx})">
                                <div class="checkbox"></div>
                                <span class="item-name">${item.name}</span>
                            </li>
                        `).join('')}
                    </ul>
                `;
                container.appendChild(card);
            });
        }

        function toggleItem(orderId, itemIndex) {
            const order = state.orders.find(o => o.id === orderId);
            if (order) {
                order.items[itemIndex].bought = !order.items[itemIndex].bought;
                saveData();
                renderOrders();
            }
        }

        function deleteOrder(orderId) {
            if (confirm('هل أنت تأكد من حذف هذه الطلبية؟')) {
                state.orders = state.orders.filter(o => o.id !== orderId);
                saveData();
                renderOrders();
            }
        }

        // Catalog Page Management
        function renderCatalog() {
            const container = document.getElementById('catalog-list-container');
            container.innerHTML = '';
            state.catalog.forEach((item, index) => {
                const el = document.createElement('div');
                el.className = 'catalog-item';
                el.innerHTML = `
                    <span>${item}</span>
                    <span class="remove" onclick="removeCatalogItem(${index})">&times;</span>
                `;
                container.appendChild(el);
            });
        }

        function addCatalogItem() {
            const input = document.getElementById('new-catalog-input');
            const val = input.value.trim();
            if (val && !state.catalog.includes(val)) {
                state.catalog.push(val);
                saveData();
                input.value = '';
                renderCatalog();
            }
        }

        function removeCatalogItem(index) {
            state.catalog.splice(index, 1);
            saveData();
            renderCatalog();
        }

        // JSON Export
        function exportData() {
            const dataStr = "data:text/json;charset=utf-
